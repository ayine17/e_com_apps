DATABASE_URL="postgresql://postgres@localhost:5433/marketplace"
# Long random string; generate with: openssl rand -base64 48
JWT_SECRET="change-me"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
PLATFORM_CURRENCY="USD"
# Platform commission in basis points (800 = 8%)
PLATFORM_FEE_BPS=800
# Days after delivery before escrow auto-releases
RELEASE_AFTER_DAYS=7
# Days a seller has to ship a paid order before it is cancelled and refunded
HANDLING_DAYS=3
# Days a seller has to respond to a dispute
DISPUTE_RESPONSE_DAYS=3
# Orders above this (minor units) from accounts younger than 24h add risk
HIGH_VALUE_THRESHOLD_MINOR=50000
# "fake" until Stripe test keys are provided
PAYMENT_PROVIDER="fake"
# Shared secret the carrier uses to sign delivery webhooks
CARRIER_WEBHOOK_SECRET="change-me-too"
